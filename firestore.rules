rules_version = '2';

// CatSight — deny all client access.
//
// Nothing in this project needs a browser to reach Firestore. The frontend
// calls the Cloud Run API directly (C-10) and the API reads Firestore with the
// service account's credentials, which bypass these rules entirely.
//
// So "deny all" is the correct and complete rule, not a placeholder to relax
// later. If a future feature appears to need client reads, the answer is an
// API endpoint: these documents hold a reinsurer's treaty terms and priced
// positions, and a public read on `analyses` would publish them.
//
// Deployed with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
