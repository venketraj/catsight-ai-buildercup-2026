{
  "displayName": "CatSight - live service",
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "height": 12,
        "widget": {
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_BAR"
            },
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "86400s",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "perSeriesAligner": "ALIGN_SUM"
                },
                "filter": "metric.type=\"logging.googleapis.com/user/catsight_analyses\""
              }
            }
          },
          "title": "Analyses - last 24 h"
        },
        "width": 12
      },
      {
        "height": 12,
        "widget": {
          "scorecard": {
            "thresholds": [
              {
                "color": "YELLOW",
                "direction": "ABOVE",
                "value": 30.0
              },
              {
                "color": "RED",
                "direction": "ABOVE",
                "value": 90.0
              }
            ],
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "86400s",
                  "crossSeriesReducer": "REDUCE_MEAN",
                  "perSeriesAligner": "ALIGN_PERCENTILE_50"
                },
                "filter": "metric.type=\"logging.googleapis.com/user/catsight_live_seconds\""
              }
            }
          },
          "title": "Live analysis time, median (s)"
        },
        "width": 12,
        "xPos": 12
      },
      {
        "height": 12,
        "widget": {
          "scorecard": {
            "thresholds": [
              {
                "color": "RED",
                "direction": "ABOVE",
                "value": 0.05
              }
            ],
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "86400s",
                  "crossSeriesReducer": "REDUCE_MEAN",
                  "perSeriesAligner": "ALIGN_PERCENTILE_50"
                },
                "filter": "metric.type=\"logging.googleapis.com/user/catsight_live_cost_usd\""
              }
            }
          },
          "title": "Model cost per live analysis, median (USD)"
        },
        "width": 12,
        "xPos": 24
      },
      {
        "height": 12,
        "widget": {
          "scorecard": {
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "86400s",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "perSeriesAligner": "ALIGN_SUM"
                },
                "filter": "metric.type=\"logging.googleapis.com/user/catsight_citations_withheld\""
              }
            }
          },
          "title": "Citations withheld - last 24 h"
        },
        "width": 12,
        "xPos": 36
      },
      {
        "height": 20,
        "widget": {
          "pieChart": {
            "chartType": "DONUT",
            "dataSets": [
              {
                "sliceNameTemplate": "${metric.labels.mode}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "86400s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.mode"
                      ],
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/catsight_analyses\""
                  }
                }
              }
            ],
            "showLabels": true
          },
          "title": "Analyses by mode - last 24 h"
        },
        "width": 16,
        "yPos": 12
      },
      {
        "height": 20,
        "widget": {
          "title": "Wording citations per hour",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "Verified",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/catsight_citations_verified\""
                  }
                }
              },
              {
                "legendTemplate": "Withheld",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/catsight_citations_withheld\""
                  }
                }
              }
            ]
          }
        },
        "width": 16,
        "xPos": 16,
        "yPos": 12
      },
      {
        "height": 20,
        "widget": {
          "title": "Clause Courtroom outcomes per hour",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "Argued and priced",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/catsight_courtroom_done\""
                  }
                }
              },
              {
                "legendTemplate": "Skipped (no qualifying flag)",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/catsight_courtroom_skipped\""
                  }
                }
              },
              {
                "legendTemplate": "Counsel dropped (bad quote)",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_SUM"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/catsight_counsel_dropped\""
                  }
                }
              }
            ]
          }
        },
        "width": 16,
        "xPos": 32,
        "yPos": 12
      },
      {
        "height": 14,
        "widget": {
          "timeSeriesTable": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "opsAnalyticsQuery": {
                    "sql": "-- One row per analysis, newest first, with its Courtroom outcome joined on.\n-- Log Analytics (SQL) over the _Default bucket; used by the dashboard's run\n-- table (scripts/observability_dashboard.json). Columns come from the\n-- analysis_done and courtroom_* lines written by backend/app/logs.py and main.py.\nWITH runs AS (\n  SELECT\n    timestamp,\n    JSON_VALUE(json_payload, '$.run_id')                                   AS run_id,\n    JSON_VALUE(json_payload, '$.event_id')                                 AS event,\n    JSON_VALUE(json_payload, '$.mode')                                     AS mode,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.money_seconds') AS FLOAT64)      AS money_s,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.seconds') AS FLOAT64)            AS total_s,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.agent_seconds.exposure_analyst') AS FLOAT64) AS exposure_s,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.agent_seconds.wording_checker') AS FLOAT64)  AS wording_s,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.agent_seconds.verifier') AS FLOAT64)         AS verifier_s,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.agent_seconds.reporter') AS FLOAT64)         AS reporter_s,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.calls') AS INT64)                AS model_calls,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.tool_calls') AS INT64)           AS tool_calls,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.retrievals') AS INT64)           AS retrievals,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.tokens_in') AS INT64)            AS tokens_in,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.tokens_out') AS INT64)           AS tokens_out,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.cost_usd') AS FLOAT64)           AS cost_usd,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.verified') AS INT64)             AS flags_verified,\n    SAFE_CAST(JSON_VALUE(json_payload, '$.withheld') AS INT64)             AS flags_withheld\n  FROM `techno-crackers-catsight.global._Default._AllLogs`\n  WHERE JSON_VALUE(json_payload, '$.component') = 'catsight-api'\n    AND JSON_VALUE(json_payload, '$.event') = 'analysis_done'\n),\ncourt AS (\n  SELECT\n    JSON_VALUE(json_payload, '$.run_id') AS run_id,\n    ANY_VALUE(CASE JSON_VALUE(json_payload, '$.event')\n      WHEN 'courtroom_done' THEN CONCAT('argued, ', JSON_VALUE(json_payload, '$.sides_verified'), ' of 2 sides verified')\n      ELSE 'skipped' END) AS courtroom,\n    SUM(SAFE_CAST(JSON_VALUE(json_payload, '$.cost_usd') AS FLOAT64)) AS courtroom_cost_usd\n  FROM `techno-crackers-catsight.global._Default._AllLogs`\n  WHERE JSON_VALUE(json_payload, '$.component') = 'catsight-api'\n    AND JSON_VALUE(json_payload, '$.event') IN ('courtroom_done', 'courtroom_skipped')\n  GROUP BY run_id\n)\nSELECT\n  FORMAT_TIMESTAMP('%d %b %H:%M', r.timestamp, 'Asia/Kolkata') AS time_ist,\n  r.event, r.mode, r.money_s, r.total_s,\n  r.exposure_s, r.wording_s, r.verifier_s, r.reporter_s,\n  r.model_calls, r.tool_calls, r.retrievals, r.tokens_in, r.tokens_out,\n  r.cost_usd, r.flags_verified, r.flags_withheld,\n  IFNULL(c.courtroom, '-') AS courtroom, c.courtroom_cost_usd,\n  r.run_id\nFROM runs r LEFT JOIN court c USING (run_id)\nORDER BY r.timestamp DESC\nLIMIT 50\n"
                  }
                }
              }
            ],
            "metricVisualization": "NUMBER"
          },
          "title": "analytics table"
        },
        "width": 48,
        "yPos": 32
      }
    ]
  }
}
