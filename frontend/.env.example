# CatSight frontend configuration — TEMPLATE
#
# Copy to frontend/.env.local and fill in the placeholder.
# Vite only exposes vars prefixed VITE_ to the browser. Put NO secrets here —
# anything in this file ships to the client.

# ── API base URL ─────────────────────────────────────────────────────────────
# The browser calls Cloud Run DIRECTLY (C-10) — never through a Firebase
# Hosting rewrite, which has a 60 s timeout and does not stream SSE.
#
# This URL only exists after the first deploy. `scripts/deploy.sh` prints it as
# "Service URL: https://catsight-api-xxxx-uc.a.run.app".
#
# Local dev:
VITE_API_BASE_URL=http://localhost:8080
# Deployed:
# VITE_API_BASE_URL=https://<CLOUD_RUN_SERVICE_URL>

# ── Build metadata (optional, shown in the UI footer) ────────────────────────
VITE_BUILD_LABEL=dev
